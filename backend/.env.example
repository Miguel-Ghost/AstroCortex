# Copy to .env for local runs (never commit .env)
CORS_ORIGINS=http://localhost:5173
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# DATABASE_URL=postgresql://user:pass@host:5432/spherex   # empty -> marks kept in memory
# MODEL_PATH=models/model.onnx                             # empty -> rule-based classifier (v0)
# LLM_API_KEY=                                             # empty -> recorded agent tours only
# STATIC_DIR=data/static
# MAX_FOV_ARCMIN=5
